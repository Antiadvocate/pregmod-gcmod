+				confirmClear.append(confirmClearTitle, clearButton, cancelButton);
+
+				list.appendChild(confirmClear);
+				setTimeout(() => {
+					if (replaceChildren) {
+						savesDiv.replaceChildren(list);
+					} else { // curse you, itch app!
+						savesDiv.innerHTML = "";
+						savesDiv.appendChild(list);
+					}
+				}, Engine.minDomActionDelay);
