+				li.appendChild(idbtoggle);
+				ul.appendChild(li);
+
+				list.appendChild(ul);
+
+				setTimeout(() => {
+					if (replaceChildren) {
+						savesDiv.replaceChildren(list);
+					} else { // curse you, itch app!
+						savesDiv.innerHTML = "";
+						savesDiv.appendChild(list);
+					}
+					const pageField = document.getElementById("pageNum");
+					if (pageField != null) {
+						pageField.value = listPage;
+					}
+					const lengthField = document.getElementById("pageLen");
+					if (lengthField != null) {
+						lengthField.value = listLength;
+					}
+					Dialog.resize(); // fix dialog size
+				}, Engine.minDomActionDelay);
+				break;
+			}
+			case "confirm save": {
