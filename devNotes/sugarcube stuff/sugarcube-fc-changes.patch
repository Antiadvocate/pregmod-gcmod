+				list.appendChild(confirmLoad);
+				setTimeout(() => {
+					if (replaceChildren) {
+						savesDiv.replaceChildren(list);
+					} else { // curse you, itch app!
+						savesDiv.innerHTML = "";
+						savesDiv.appendChild(list);
+					}
+				}, Engine.minDomActionDelay);
+				break;
+			}
